{
    "name": "d3creative/statamic-popcorn",
    "description": "Popcorn by D3 Creative - Upload, choose and play Mux videos from a Statamic fieldtype, including videos already in your asset library.",
    "type": "statamic-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "D3 Creative",
            "homepage": "https://d3creative.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/d3creativeuk/statamic-popcorn/issues",
        "source": "https://github.com/d3creativeuk/statamic-popcorn"
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.34"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8 || ^11.0",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "D3Creative\\Popcorn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "D3Creative\\Popcorn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Popcorn",
            "description": "Upload, choose and play Mux videos from a fieldtype, including videos already in your asset library.",
            "developer": "D3 Creative",
            "developer_url": "https://d3creative.uk",
            "tags": [
                "video",
                "mux",
                "fieldtype"
            ]
        },
        "laravel": {
            "providers": [
                "D3Creative\\Popcorn\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "prefer-stable": true
}
